# Server-only values. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDA_API_TOKEN=
EDA_WORKSPACE_ID=gongyueetree

# BOM identity enrichment (same credentials/names as bom2buy; server-only)
EZPLM_API_BASE=https://your-ezplm-host
EZPLM_API_KEY=
# Optional separate signing secret; default is API key
EZPLM_API_SECRET=
ICEASY_ACCOUNT=
ICEASY_PASSWORD=
ICEASY_TZ=Asia/Shanghai
# Optional fixed-egress proxy, for Iceasy IP allowlisting
ICEASY_PROXY_URL=
ICEASY_PROXY_TOKEN=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_ENV=production
DIGIKEY_MOCK=false
MOUSER_API_KEY=

# Optional Allegro conversion worker (KiCad 10+, deployed separately from Vercel).
# The UI also requires the existing EDA_API_TOKEN for online conversion.
# Use the complete HTTPS endpoint ending in /convert. Never use NEXT_PUBLIC_ for these.
ALLEGRO_CONVERTER_URL=
ALLEGRO_CONVERTER_TOKEN=
