{
  "name": "canon-eda-ir-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "dev:vercel": "next dev",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:parser && npm run build && node --test tests/rendered-html.test.mjs",
    "test:parser": "node --import tsx --test tests/altium-native.test.ts tests/parser-regressions.test.ts tests/knowledge.test.ts tests/viewer-interactions.test.tsx tests/bom-mapping.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern schematic-reconstruction",
    "postinstall": "node scripts/prepare-pdf.mjs",
    "test:knowledge": "node --import tsx --test tests/knowledge.test.ts",
    "mine:batch": "node --import tsx scripts/batch-mine.ts",
    "verify:project": "node --import tsx scripts/verify-project.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "occt-import-js": "^0.0.23",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
